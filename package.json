{
  "name": "plugin-fizzl",
  "version": "0.6.1",
  "description": "ElizaOS plugin: 9 paid tools for crypto agents, paid per call in USDC over x402 on Solana or Base (no API keys). Trading signals (Ichimoku, 6-indicator confluence, price levels with stop and targets, a market scan of 148 top-200 coins), wallet-approval risk checks, pre-sign checks and x402 endpoint checks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fizzl13/plugin-fizzl"
  },
  "homepage": "https://github.com/Fizzl13/plugin-fizzl#readme",
  "bugs": {
    "url": "https://github.com/Fizzl13/plugin-fizzl/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "dependencies": {
    "@solana/kit": "^8.3.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "@x402/svm": "^2.27.0",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "SVM_PRIVATE_KEY": {
        "type": "string",
        "description": "Solana secret key (base58) that pays Fizzl services in USDC on Solana (all except presign-guard, which is Base only)",
        "required": false,
        "sensitive": true
      },
      "EVM_PRIVATE_KEY": {
        "type": "string",
        "description": "EVM private key (0x…) that pays in USDC on Base; needed for presign-guard, otherwise optional when SVM_PRIVATE_KEY is set",
        "required": false,
        "sensitive": true
      },
      "FIZZL_MAX_PAYMENT_USD": {
        "type": "string",
        "description": "Refuse any single payment above this amount in USD",
        "required": false,
        "default": "0.25"
      },
      "ICHIMOKU_SIGNAL_URL": {
        "type": "string",
        "description": "Ichimoku Signal base URL",
        "required": false,
        "default": "https://ichimoku-signal.onrender.com"
      },
      "PLAINTEXT_URL": {
        "type": "string",
        "description": "PlainText base URL",
        "required": false,
        "default": "https://smartcontractexplainer.onrender.com"
      },
      "PRESIGN_GUARD_URL": {
        "type": "string",
        "description": "presign-guard base URL",
        "required": false,
        "default": "https://presign-guard.onrender.com"
      },
      "SOLANA_RPC_URL": {
        "type": "string",
        "description": "Solana RPC used to build payments (default: public mainnet RPC)",
        "required": false
      }
    }
  },
  "keywords": [
    "elizaos",
    "elizaos-plugin",
    "x402",
    "solana",
    "base",
    "trading",
    "ichimoku",
    "wallet-security",
    "approvals",
    "diagnostics",
    "safety",
    "presign",
    "eip-712",
    "crypto",
    "crypto-signals",
    "trading-signals",
    "technical-analysis",
    "market-scan",
    "screener",
    "rsi",
    "macd",
    "support-resistance",
    "usdc",
    "micropayments",
    "ai-agents",
    "agent-tools",
    "mcp"
  ],
  "license": "MIT"
}
